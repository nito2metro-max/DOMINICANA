# --- Base de datos (PostgreSQL / Supabase Postgres) ---
DATABASE_URL=postgres://dflow:dflow@localhost:5432/dominicanflow
# Base de datos aislada para pruebas de integración (se borra en cada ejecución)
DATABASE_URL_TEST=postgres://dflow:dflow@localhost:5432/dominicanflow_test

# --- Aplicación ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nombre y eslogan (también editables en src/config/site.ts)
NEXT_PUBLIC_SITE_NAME="Dominican Flow"

# --- Almacenamiento de archivos ---
# "local" guarda en ./storage (solo desarrollo). Para producción ver docs/DEPLOY.md
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# --- Pagos (DESACTIVADOS) ---
# La plataforma NO procesa pagos. Ver docs/PAGOS.md antes de activar nada.
PAYMENTS_PROVIDER=none
# STRIPE_SECRET_KEY=        # solo servidor, nunca NEXT_PUBLIC_
# STRIPE_WEBHOOK_SECRET=
